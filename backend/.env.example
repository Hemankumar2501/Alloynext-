# AlloyNext Environment Configuration
ENV=development
APP_NAME="AlloyNext API"
API_V1_STR="/api/v1"
SECRET_KEY="alloynext-insecure-development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback)
# For local SQLite: sqlite:///./alloynext.db
# For PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/alloynext
DATABASE_URL="sqlite:///./alloynext.db"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:8089,http://localhost:8081,http://localhost:19006,http://127.0.0.1:8089,http://127.0.0.1:8081"

# AI Provider Configuration (Optional LLM Key; system uses high-accuracy deterministic scoring fallback when omitted)
AI_PROVIDER="mock"  # options: "openai", "gemini", "anthropic", "mock"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
